<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>H2Sharp.EntityFrameworkCore.NodaTime</AssemblyName>
    <RootNamespace>H2Sharp.EntityFrameworkCore.NodaTime</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="'$(DeveloperBuild)' == 'True'">net8.0</TargetFramework>

    <Authors>Shay Rojansky</Authors>
    <Description>NodaTime support plugin for the H2 Entity Framework Core provider.</Description>
    <PackageTags>h2;h2sharp;Entity Framework Core;entity-framework-core;ef;efcore;orm;sql;nodatime;date;time</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      EF1001: the provider's convention set builder takes IH2SingletonOptions, which is public but
      lives in a namespace ending in .Internal, and the analyzer flags that naming convention across
      assembly boundaries. The convention set builder is replaced with one derived from the
      provider's, so the option has to be passed along.
    -->
    <NoWarn>$(NoWarn);EF1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\H2Sharp.EntityFrameworkCore\H2Sharp.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="build\**\*">
      <Pack>True</Pack>
      <PackagePath>build</PackagePath>
    </None>
  </ItemGroup>

</Project>
