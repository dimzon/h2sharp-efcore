<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>H2Sharp.EntityFrameworkCore.FunctionalTests</AssemblyName>
    <RootNamespace>H2Sharp.EntityFrameworkCore</RootNamespace>
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Not yet ported. These files came from the EFCore.PG fork and still assume PostgreSQL types and
      server behaviour H2 has no answer for: range and multirange types, the full-text search types,
      the network address types, sequences, Redshift and the compatibility mode, and the ICU
      collation. They are excluded from the compilation until they are rewritten against H2, and each
      one is listed in docs/DIVERGENCES.md.
    -->
    <Compile Remove="TestUtilities\TestRelationalCommandBuilderFactory.cs" />
    <Compile Remove="TestUtilities\TestRelationalTransaction.cs" />
    <!--
      Fabricates connection failures, which needs a public constructor on the engine's
      H2SharpException; the port's is internal (a port defect, see docs/DIVERGENCES.md).
    -->
    <Compile Remove="TestUtilities\TestH2Connection.cs" />
    <!--
      Needs the TestRelationalCommandBuilderFactory/TestRelationalTransactionFactory fakes, which
      the EF Core 9 template-based IRelationalCommand makes into a rewrite rather than a port;
      see docs/DIVERGENCES.md.
    -->
    <Compile Remove="ExecutionStrategyTest.cs" />
    <!--
      Both suites save through the batch, and the port's Prepared update path is a stub ("Not
      ported yet: Prepared.update"), so every save fails at the engine. The classes carry the
      BlockedByPort trait; the reference accepts the statements this provider writes.
    -->
    <!--
      Both refer to model classes the fork did not carry over (BronieContext, BlogContextSequence
      and the rest of that family), so they do not compile until those models are ported.
    -->
    <Compile Remove="SequenceEndToEndTest.cs" />
    <Compile Remove="H2ValueGenerationScenariosTest.cs" />
    <!--
      These two spec suites model string properties whose store type is an H2 date or time
      (for example BuiltInDataTypes.TestDateOnly), and our type mapping source has no mapping
      for CLR string over date/time columns, so model validation fails before any SQL is
      generated. Settlement needs a design decision, not an engine fix: see docs/DIVERGENCES.md.
    -->
    <Compile Remove="ValueConvertersEndToEndH2Test.cs" />
    <Compile Remove="CustomConvertersH2Test.cs" />
    <!--
      The NodaTime mapping test of the PostgreSQL provider: it needs the legacy timestamp
      behaviour, which only PostgreSQL had, and the range types, which H2 has no answer for.
      The file was guarded with "#if DEBUG" upstream, which hid it from a Release build and
      left it broken in a Debug one.
    -->
    <Compile Remove="Query\LegacyH2NodaTimeTypeMappingTest.cs" />
  </ItemGroup>

