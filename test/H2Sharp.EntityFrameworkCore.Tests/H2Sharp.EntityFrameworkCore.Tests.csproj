<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>H2Sharp.EntityFrameworkCore.Tests</AssemblyName>
    <RootNamespace>H2Sharp.EntityFrameworkCore</RootNamespace>

    <NoWarn>$(NoWarn);NU1903</NoWarn> <!-- TEMPORARY, DO NOT MERGE -->
    <NuGetAudit>false</NuGetAudit>
    <NuGetAuditLevel>critical</NuGetAuditLevel>
  </PropertyGroup>

    <ItemGroup>
    <!--
      Not yet ported: these still assume PostgreSQL types and server behaviour that H2 has no
      answer for. See docs/DIVERGENCES.md.
    -->
      <Compile Remove="Scaffolding\H2CodeGeneratorTest.cs" />
      <Compile Remove="Storage\H2TypeMappingSourceTest.cs" />
      <Compile Remove="Storage\H2TypeMappingTest.cs" />
      <Compile Remove="H2DbContextOptionsExtensionsTest.cs" />
      <Compile Remove="H2RelationalConnectionTest.cs" />
      <Compile Remove="Storage\H2NodaTimeTypeMappingTest.cs" />
      <Compile Remove="Types\LTreeTest.cs" />
      <Compile Remove="Update\H2ModificationCommandBatchTest.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\H2Sharp.EntityFrameworkCore\H2Sharp.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\H2Sharp.EntityFrameworkCore.NodaTime\H2Sharp.EntityFrameworkCore.NodaTime.csproj" />
    <ProjectReference Include="..\H2Sharp.EntityFrameworkCore.FunctionalTests\H2Sharp.EntityFrameworkCore.FunctionalTests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />

    <!--
      The coverage of the provider is measured by the collector of coverlet: it writes the report
      of the run, and tools/CheckCoverage.ps1 reads the report and holds the threshold. The
      collector is the only coverlet there is in the package cache, and the threshold cannot be a
      property of the build without the msbuild package.
    -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />

    <!-- Needed to override xunit dependencies from EFCore projects on versions which aren't available on nuget.org -->
    <PackageReference Include="xunit.assert" />
    <PackageReference Include="xunit.core" />
  </ItemGroup>

</Project>
