<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>H2Sharp.EntityFrameworkCore.FunctionalTests</AssemblyName>
    <RootNamespace>H2Sharp.EntityFrameworkCore</RootNamespace>
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Not yet ported. These files came from the EFCore.PG fork and still assume PostgreSQL types and
      server behaviour H2 has no answer for: range and multirange types, the full-text search types,
      the network address types, sequences, Redshift and the compatibility mode, and the ICU
      collation. They are excluded from the compilation until they are rewritten against H2, and each
      one is listed in docs/DIVERGENCES.md.
    -->
    <!--
      Both suites save through the batch, and the port's Prepared update path is a stub ("Not
      ported yet: Prepared.update"), so every save fails at the engine. The classes carry the
      BlockedByPort trait; the reference accepts the statements this provider writes.
    -->
    <!--
      Both refer to model classes the fork did not carry over (BronieContext, BlogContextSequence
      and the rest of that family), so they do not compile until those models are ported.
    -->
    <Compile Remove="SequenceEndToEndTest.cs" />
    <Compile Remove="H2ValueGenerationScenariosTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Not yet ported. These files came from the EFCore.PG fork and still assume PostgreSQL types and
      server behaviour H2 has no answer for: range and multirange types, the full-text search types,
      the network address types, sequences, Redshift and the compatibility mode, the ICU collation,
      PostGIS, and PostgreSQL's arrays, jsonb operators and trigram search. They are excluded from the
      compilation until they are rewritten against H2, and each one is listed in docs/DIVERGENCES.md.
    -->
    <Compile Remove="BuiltInDataTypesH2Test.cs" />
    <Compile Remove="Query\NorthwindDbFunctionsQueryH2Test.cs" />
    <Compile Remove="Query\NorthwindFunctionsQueryH2Test.cs" />
    <Compile Remove="Query\JsonDomQueryTest.cs" />
    <Compile Remove="Query\JsonStringQueryTest.cs" />
    <Compile Remove="Query\SpatialQueryH2Fixture.cs" />
    <Compile Remove="Query\SpatialQueryH2GeographyTest.cs" />
    <Compile Remove="Query\SpatialQueryH2GeometryTest.cs" />
    <Compile Remove="Query\GearsOfWarFromSqlQueryH2Test.cs" />
    <Compile Remove="Query\GearsOfWarQueryH2Fixture.cs" />
    <Compile Remove="Query\GearsOfWarQueryH2Test.cs" />
    <Compile Remove="Query\TPCGearsOfWarQueryH2Fixture.cs" />
    <Compile Remove="Query\TPCGearsOfWarQueryH2Test.cs" />
    <Compile Remove="Query\TPTGearsOfWarQueryH2Fixture.cs" />
    <Compile Remove="Query\TPTGearsOfWarQueryH2Test.cs" />
    <Compile Remove="Query\BigIntegerQueryTest.cs" />
    <Compile Remove="Query\CitextQueryTest.cs" />
    <Compile Remove="Query\EnumQueryTest.cs" />
    <Compile Remove="Query\FullTextSearchDbFunctionsH2Test.cs" />
    <Compile Remove="Query\FuzzyStringMatchQueryH2Test.cs" />
    <Compile Remove="Query\IncludeH2Fixture.cs" />
    <Compile Remove="Query\NavigationTest.cs" />
    <Compile Remove="Query\NodaTimeQueryH2Test.cs" />
    <Compile Remove="Query\TimestampQueryTest.cs" />
    <Compile Remove="Query\TrigramsQueryH2Test.cs" />
    <Compile Remove="Query\UdfDbFunctionH2Tests.cs" />
    <Compile Remove="SystemColumnTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\H2Sharp.EntityFrameworkCore\H2Sharp.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\H2Sharp.EntityFrameworkCore.NTS\H2Sharp.EntityFrameworkCore.NTS.csproj" />
    <ProjectReference Include="..\..\src\H2Sharp.EntityFrameworkCore.NodaTime\H2Sharp.EntityFrameworkCore.NodaTime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" />
    <!--
      See Directory.Packages.props: the specification tests bring a vulnerable
      Microsoft.Build.Tasks.Core, which itself brings vulnerable crypto builds; the direct
      references pin the patched versions for the whole test graph.
    -->
    <PackageReference Include="Microsoft.Build.Tasks.Core" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />

    <!--
      The coverage of the provider is measured by the collector of coverlet: it writes the report
      of the run, and tools/CheckCoverage.ps1 reads the report and holds the threshold. The
      collector is the only coverlet there is in the package cache, and the threshold cannot be a
      property of the build without the msbuild package.
    -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />

    <!-- Needed to override xunit dependencies from EFCore projects on versions which aren't available on nuget.org -->
    <PackageReference Include="xunit.assert" />
    <PackageReference Include="xunit.core" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

