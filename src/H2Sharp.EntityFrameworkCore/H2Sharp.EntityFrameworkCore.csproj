<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>H2Sharp.EntityFrameworkCore</AssemblyName>
    <RootNamespace>H2Sharp.EntityFrameworkCore</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>

    <Authors>Shay Rojansky;Austin Drenski;Yoh Deadfall;</Authors>
    <Description>H2Sharp provider for Entity Framework Core.</Description>
    <PackageTags>h2;h2sharp;database;Entity Framework Core;entity-framework-core;ef;efcore;orm;sql</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>EF9100</NoWarn> <!-- Precompiled query is experimental -->
  </PropertyGroup>

  <!--
    H2Sharp is the embedded H2 port this provider sits on. It is a sibling repository and is not
    published to nuget.org yet, so it comes in as a project reference. Set H2SharpProject to point
    elsewhere once the engine ships as a package.
  -->
  <PropertyGroup>
    <H2SharpProject Condition="'$(H2SharpProject)' == ''">$(MSBuildThisFileDirectory)..\..\h2sharp\src\H2Sharp\H2Sharp.csproj</H2SharpProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="none" is set to flow the EF Core analyzer to users referencing this package https://github.com/aspnet/EntityFrameworkCore/pull/11350 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" PrivateAssets="none" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" PrivateAssets="none" />
    <ProjectReference Include="$(H2SharpProject)" />
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" />

    <None Update="Properties\H2Strings.Designer.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>H2Strings.Designer.cs</LastGenOutput>
    </None>

    <None Update="Properties\SqlServerStrings.Designer.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>

    <Compile Update="Properties\H2Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>H2Strings.Designer.tt</DependentUpon>
    </Compile>

    <EmbeddedResource Update="Properties\H2Strings.resx">
      <CustomToolNamespace>H2Sharp.EntityFrameworkCore.Internal</CustomToolNamespace>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
