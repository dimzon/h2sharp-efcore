<Project>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <EFCoreH2NetTopologySuiteFile>$(IntermediateOutputPath)EFCoreH2NetTopologySuite$(DefaultLanguageSourceExtension)</EFCoreH2NetTopologySuiteFile>
  </PropertyGroup>
  <Choose>
    <When Condition="'$(Language)' == 'F#'">
      <Choose>
        <When Condition="'$(OutputType)' == 'Exe' OR '$(OutputType)' == 'WinExe'">
          <PropertyGroup>
            <CodeFragmentItemGroup>CompileBefore</CodeFragmentItemGroup>
          </PropertyGroup>
        </When>
        <Otherwise>
          <PropertyGroup>
            <CodeFragmentItemGroup>CompileAfter</CodeFragmentItemGroup>
          </PropertyGroup>
        </Otherwise>
      </Choose>
    </When>
    <Otherwise>
      <PropertyGroup>
        <CodeFragmentItemGroup>Compile</CodeFragmentItemGroup>
      </PropertyGroup>
    </Otherwise>
  </Choose>
  <Target Name="AddEFCoreH2NetTopologySuite"
          BeforeTargets="CoreCompile"
          DependsOnTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'True'"
          Inputs="$(MSBuildAllProjects)"
          Outputs="$(EFCoreH2NetTopologySuiteFile)">
    <ItemGroup>
      <EFCoreH2NetTopologySuiteServices Include="Microsoft.EntityFrameworkCore.Design.DesignTimeServicesReferenceAttribute">
        <_Parameter1>H2Sharp.EntityFrameworkCore.Design.Internal.H2NetTopologySuiteDesignTimeServices, H2Sharp.EntityFrameworkCore.NetTopologySuite</_Parameter1>
        <_Parameter2>H2Sharp.EntityFrameworkCore</_Parameter2>
      </EFCoreH2NetTopologySuiteServices>
    </ItemGroup>
    <WriteCodeFragment AssemblyAttributes="@(EFCoreH2NetTopologySuiteServices)"
                       Language="$(Language)"
                       OutputFile="$(EFCoreH2NetTopologySuiteFile)">
      <Output TaskParameter="OutputFile" ItemName="$(CodeFragmentItemGroup)" />
      <Output TaskParameter="OutputFile" ItemName="FileWrites" />
    </WriteCodeFragment>
  </Target>
</Project>
