<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!--
    The coverage of the provider is measured by the collector of coverlet: it writes the report
    of the run, and tools/CheckCoverage.ps1 reads the report and holds the threshold. The
    collector is the only coverlet there is in the package cache, and the threshold cannot be a
    property of the build without the msbuild package.

    Only the provider itself is measured. The tests are the instrument, not the subject.
  -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[H2Sharp.EntityFrameworkCore]H2Sharp.EntityFrameworkCore.*</Include>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <Exclude>[H2Sharp.EntityFrameworkCore]H2Sharp.EntityFrameworkCore.Migrations.*</Exclude>
          <SingleHit>false</SingleHit>
          <UseSourceLink>true</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
