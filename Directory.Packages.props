<Project>
  <PropertyGroup>
    <EFCoreVersion>[9.0.23, 10.0.0)</EFCoreVersion>
    <MicrosoftExtensionsVersion>9.0.14</MicrosoftExtensionsVersion>
    <!-- The engine ships its own version line (0.x while the port is unfinished). -->
    <H2SharpVersion>0.1.43-alpha.1</H2SharpVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="H2Sharp" Version="$(H2SharpVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EFCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EFCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="$(EFCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" Version="$(EFCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EFCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="NodaTime" Version="3.2.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.14" />
    <PackageVersion Include="NetTopologySuite" Version="2.6.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.200" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.assert" Version="2.9.3" />
    <PackageVersion Include="xunit.core" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.1" />
    <!--
      The collector of the coverage. The threshold is checked by tools/CheckCoverage.ps1: the
      msbuild package of coverlet, which could hold the threshold in the build itself, is not
      in the package cache.
    -->
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>
</Project>